{
  "dataSources": {
    "ds_PjuDCKN6": {
      "type": "ds.search",
      "options": {
        "query": "index=\"black_missing_database\"\n| eval latitude=tonumber(latitude), longitude=tonumber(longitude)\n| where isnotnull(latitude) AND isnotnull(longitude)\n| sort 0 - _time\n| dedup case_id\n| table case_id full_name case_summary_short last_seen_city last_seen_state latitude longitude",
        "queryParameters": {
          "earliest": "0",
          "sampleRatio": 1,
          "latest": ""
        }
      },
      "name": "Table search"
    },
    "ds_RPf05M5b": {
      "type": "ds.search",
      "options": {
        "query": "index=\"black_missing_database\"\n| stats dc(case_id) AS total_cases"
      },
      "name": "Search_1"
    },
    "ds_9eXeUKWO": {
      "type": "ds.search",
      "options": {
        "query": "index=\"black_missing_database\"\n| sort 0 - _time\n| dedup case_id\n| stats count AS Cases BY case_classification\n| rename case_classification AS Classification\n| sort - Cases"
      },
      "name": "Search_2"
    }
  },
  "visualizations": {
    "viz_vIhacTSb": {
