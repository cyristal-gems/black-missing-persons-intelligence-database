{
  "dataSources": {
    "ds_6SXPvkkT": {
      "type": "ds.search",
      "options": {
        "query": "index=black_missing_database\n| rename age_at_missing AS \"Age\"\n| rename missing_date AS \"Missing Since\"\n| rename last_seen_city AS \"Last Seen City\"\n| rename last_seen_state AS \"Last Seen State\"\n| rename case_status AS \"Status\"\n| rename case_classification AS \"Classification\"\n| rename case_summary_short AS \"Summary\"\n| table full_name latitude longitude Age \"Missing Since\" \"Last Seen City\" \"Last Seen State\" Status Classification Summary image_url"
      },
      "name": "Search_1"
    },
    "ds_44bkBNmT": {
      "type": "ds.search",
      "options": {
        "query": "index=black_missing_database\n| stats count"
      },
      "name": "Search_2"
    },
    "ds_akqco0cC": {
      "type": "ds.search",
      "options": {
        "query": "index=black_missing_database\n| stats count by case_classification\n| sort -count"
      },
      "name": "Search_3"
    },
    "ds_6dc9oSO3": {
      "type": "ds.search",
      "options": {
        "query": "index=black_missing_database\n| eval year=strftime(strptime(missing_date,\"%m/%d/%y\"),\"%Y\")\n| stats count by year\n| sort year"
      },
      "name": "Search_4"
    }
  },
  "visualizations": {
    "viz_nYU12hki": {
      "type": "splunk.map",
      "options": {
        "layers": [
          {
            "type": "marker",
            "tooltipHeaderField": "> primary | seriesByName('full_name')",
            "additionalTooltipFields": [
              "Age",
              "Missing Since",
              "Last Seen City",
              "Last Seen State",
              "Summary",
              "Classification",
              "Status"
            ]
